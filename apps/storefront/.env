## Storefront environment variables
#
# Cart/checkout API base URL (used only by cart-checkout-plugin in API mode).
# Keep this separate from the catalog API Base URL you configure in the Builder UI.
VITE_CART_API_BASE_URL=https://devbaascart.enetdefender.com

VITE_ORDER_API_BASE_URL=https://devbaasorder.enetdefender.com
